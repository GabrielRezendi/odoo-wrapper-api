# Server
PORT=3000
NODE_ENV=development

# CORS (comma-separated origins; leave empty to allow all in dev)
# CORS_ORIGIN=https://app.example.com,https://admin.example.com

# PostgreSQL (auxiliary - sessions/tokens)
# Option 1: connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/odoo_wrapper_api

# Option 2: separate variables
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=odoo_wrapper

# Enable SSL for database connection (e.g. cloud Postgres)
DATABASE_SSL=false
# Optional: set to false to allow self-signed certificates
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Required: key for encrypting Odoo passwords in sessions (min 32 chars)
ENCRYPTION_KEY=your-secret-encryption-key-at-least-32-characters-long

# Required: Odoo instance URL (used for all API calls)
ODOO_DEFAULT_URL=https://yourcompany.odoo.com
# Required: Odoo database name (instance name)
ODOO_DEFAULT_DB=yourcompany
